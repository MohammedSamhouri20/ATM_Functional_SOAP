<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://localhost:3000/ATMService/"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  name="ATMService"
                  targetNamespace="http://localhost:3000/ATMService/">

  <wsdl:documentation>Definition for a web service called ATMService,
    which can be used to get balance, deposit, withdraw, and get transactions.
  </wsdl:documentation>

<!-- Types -->
  <wsdl:types>
    <xsd:schema targetNamespace="http://localhost:3000/ATMService/">
      <xsd:element name="Transaction">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:int"/>
            <xsd:element name="type" type="tns:TransactionType"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="createdAt" type="xsd:dateTime"/>
            <xsd:element name="availableBalance" type="xsd:decimal"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:simpleType name="TransactionType">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="Withdraw"/>
          <xsd:enumeration value="Deposit"/>
        </xsd:restriction>
      </xsd:simpleType>

      <xsd:element name="Transactions">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element ref="tns:Transaction" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="balance" type="xsd:decimal"/>

      <xsd:element name="GenericResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="data" minOccurs="0">
              <xsd:complexType>
                <xsd:choice>
                  <xsd:element ref="tns:Transaction"/>
                  <xsd:element ref="tns:Transactions"/>
                  <xsd:element ref="tns:balance"/>
                </xsd:choice>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="success" type="xsd:boolean"/>
            <xsd:element name="message" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="DepositRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:positiveInteger"/>
            <xsd:element name="amount" type="xsd:positiveInteger"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="WithdrawRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:positiveInteger"/>
            <xsd:element name="amount" type="xsd:positiveInteger"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CheckBalanceRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:positiveInteger"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ViewTransactionsRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:positiveInteger"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>

  <!-- Messages -->
  <wsdl:message name="DepositRequestMessage">
    <wsdl:part name="parameters" element="tns:DepositRequest"/>
  </wsdl:message>
  <wsdl:message name="DepositResponseMessage">
    <wsdl:part name="parameters" element="tns:GenericResponse"/>
  </wsdl:message>

  <wsdl:message name="WithdrawRequestMessage">
    <wsdl:part name="parameters" element="tns:WithdrawRequest"/>
  </wsdl:message>
  <wsdl:message name="WithdrawResponseMessage">
    <wsdl:part name="parameters" element="tns:GenericResponse"/>
  </wsdl:message>

  <wsdl:message name="CheckBalanceRequestMessage">
    <wsdl:part name="parameters" element="tns:CheckBalanceRequest"/>
  </wsdl:message>
  <wsdl:message name="CheckBalanceResponseMessage">
    <wsdl:part name="parameters" element="tns:GenericResponse"/>
  </wsdl:message>

  <wsdl:message name="ViewTransactionsRequestMessage">
    <wsdl:part name="parameters" element="tns:ViewTransactionsRequest"/>
  </wsdl:message>
  <wsdl:message name="ViewTransactionsResponseMessage">
    <wsdl:part name="parameters" element="tns:GenericResponse"/>
  </wsdl:message>

  <!-- Port Type -->
  <wsdl:portType name="ATMServicePortType">
    <wsdl:operation name="Deposit">
      <wsdl:input message="tns:DepositRequestMessage"/>
      <wsdl:output message="tns:DepositResponseMessage"/>
    </wsdl:operation>
    <wsdl:operation name="Withdraw">
      <wsdl:input message="tns:WithdrawRequestMessage"/>
      <wsdl:output message="tns:WithdrawResponseMessage"/>
    </wsdl:operation>
    <wsdl:operation name="CheckBalance">
      <wsdl:input message="tns:CheckBalanceRequestMessage"/>
      <wsdl:output message="tns:CheckBalanceResponseMessage"/>
    </wsdl:operation>
    <wsdl:operation name="ViewTransactions">
      <wsdl:input message="tns:ViewTransactionsRequestMessage"/>
      <wsdl:output message="tns:ViewTransactionsResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <!-- Binding -->
  <wsdl:binding name="ATMServiceBinding" type="tns:ATMServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <wsdl:operation name="Deposit">
      <soap:operation soapAction="http://localhost:3000/ATMService/Deposit"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>

    <wsdl:operation name="Withdraw">
      <soap:operation soapAction="http://localhost:3000/ATMService/Withdraw"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>

    <wsdl:operation name="CheckBalance">
      <soap:operation soapAction="http://localhost:3000/ATMService/CheckBalance"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>

    <wsdl:operation name="ViewTransactions">
      <soap:operation soapAction="http://localhost:3000/ATMService/ViewTransactions"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <!-- Service -->
  <wsdl:service name="ATMService">
    <wsdl:port name="ATMServicePort" binding="tns:ATMServiceBinding">
      <soap:address location="http://localhost:3000/ATMService"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>